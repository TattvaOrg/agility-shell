#!/usr/bin/env bash
# =============================================================================
#  Agility Shell -- Main Executable Launcher
#  Next-Gen Rust (`agilityd`, `agl`) & Quickshell Architecture
# =============================================================================

set -euo pipefail

SYSTEM_DATA="/usr/share/agility-shell"
USER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/agility-shell"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agility-shell"
LOG_FILE="$STATE_DIR/shell.log"

FOREGROUND=false
PASS_ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "--legacy" ]]; then
        echo "[agility-shell] Notice: Legacy Python stack has been deprecated and completely removed." >&2
        echo "[agility-shell] Running Next-Gen Rust/QML Agility Shell." >&2
    elif [[ "$arg" == "--foreground" || "$arg" == "-f" ]]; then
        FOREGROUND=true
    else
        PASS_ARGS+=("$arg")
    fi
done

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" 2>/dev/null && pwd || echo "")"

# Discover Quickshell entrypoint
SHELL_QML=""
for cand in \
    "$SELF_DIR/quickshell/agility/shell.qml" \
    "$SYSTEM_DATA/quickshell/agility/shell.qml" \
    "$USER_CONFIG/quickshell/agility/shell.qml"; do
    if [[ -f "$cand" ]]; then
        SHELL_QML="$cand"
        break
    fi
done

# If already running: toggle launcher/dashboard
if pgrep -x "quickshell" >/dev/null 2>&1; then
    if command -v agl >/dev/null 2>&1; then
        agl toggle launcher >/dev/null 2>&1 || true
    elif command -v qs >/dev/null 2>&1; then
        qs ipc call launcher toggle >/dev/null 2>&1 || true
    elif [[ -x "$SELF_DIR/target/release/agl" ]]; then
        "$SELF_DIR/target/release/agl" toggle launcher >/dev/null 2>&1 || true
    fi
    echo "[agility-shell] Agility Shell is already running. Toggled launcher."
    exit 0
fi

# Foreground / Systemd mode
if [[ -n "${INVOCATION_ID:-}" || "$FOREGROUND" == true ]]; then
    mkdir -p "$STATE_DIR"
    DAEMON_PID=""
    if ! pgrep -x "agilityd" >/dev/null 2>&1; then
        if command -v agilityd >/dev/null 2>&1; then
            agilityd >> "$LOG_FILE" 2>&1 &
            DAEMON_PID=$!
        elif [[ -x "$SELF_DIR/target/release/agilityd" ]]; then
            "$SELF_DIR/target/release/agilityd" >> "$LOG_FILE" 2>&1 &
            DAEMON_PID=$!
        fi
    fi

    cleanup() {
        if [[ -n "$DAEMON_PID" ]]; then
            kill -TERM "$DAEMON_PID" 2>/dev/null || true
        fi
    }
    trap cleanup EXIT INT TERM

    if [[ -n "$SHELL_QML" ]]; then
        exec quickshell -p "$SHELL_QML"
    else
        exec quickshell
    fi
fi

# Prefer systemd user unit when available outside systemd
if systemctl --user list-unit-files agility-shell.service &>/dev/null; then
    echo "[agility-shell] Starting Agility Shell via systemd user unit..."
    systemctl --user reset-failed agility-shell.service 2>/dev/null || true
    systemctl --user start agility-shell.service
    exit 0
fi

# Standalone launch via agl or direct
if command -v agl >/dev/null 2>&1; then
    exec agl start
elif [[ -x "$SELF_DIR/target/release/agl" ]]; then
    exec "$SELF_DIR/target/release/agl" start
elif [[ -n "$SHELL_QML" ]]; then
    mkdir -p "$STATE_DIR"
    if ! pgrep -x "agilityd" >/dev/null 2>&1; then
        if command -v agilityd >/dev/null 2>&1; then
            agilityd >> "$LOG_FILE" 2>&1 &
        elif [[ -x "$SELF_DIR/target/release/agilityd" ]]; then
            "$SELF_DIR/target/release/agilityd" >> "$LOG_FILE" 2>&1 &
        fi
    fi
    setsid quickshell -p "$SHELL_QML" </dev/null >> "$LOG_FILE" 2>&1 &
    disown
    echo "[agility-shell] Agility Shell Next-Gen started in background."
    exit 0
else
    echo "[agility-shell] Error: Could not locate shell.qml or agl binary." >&2
    exit 1
fi
