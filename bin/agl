#!/usr/bin/env bash
# =============================================================================
#  Agility Shell -- Command Line Interface (agl)
#  Main CLI tool for managing Agility Shell lifecycle, services, and configuration.
# =============================================================================

set -euo pipefail

VERSION="1.3.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/agility-shell"
SYSTEM_DATA="/usr/share/agility-shell"
SYSTEM_VENV="/usr/lib/agility-shell/venv"
REPO_DIR=""

# Determine running / source directory
SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/.. 2>/dev/null && pwd || echo "")"
if [[ -n "$SELF_DIR" && -f "$SELF_DIR/main.py" ]]; then
    REPO_DIR="$SELF_DIR"
elif [[ -d "$SYSTEM_DATA" && -f "$SYSTEM_DATA/main.py" ]]; then
    REPO_DIR="$SYSTEM_DATA"
elif [[ -d "$CONFIG_DIR" && -f "$CONFIG_DIR/main.py" ]]; then
    REPO_DIR="$CONFIG_DIR"
fi

# -- Colors --------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

info()    { echo -e "${CYAN}${BOLD}[agl]${RESET} $*"; }
success() { echo -e "${GREEN}${BOLD}[agl:ok]${RESET} $*"; }
warn()    { echo -e "${YELLOW}${BOLD}[agl:warn]${RESET} $*"; }
error()   { echo -e "${RED}${BOLD}[agl:err]${RESET} $*" >&2; }
die()     { error "$*"; exit 1; }

# -- Help message --------------------------------------------------------------
show_help() {
    echo -e "${BOLD}Agility Shell CLI (agl)${RESET} - Management utility for agility-shell"
    echo -e ""
    echo -e "${BOLD}USAGE:${RESET}"
    echo -e "    agl <command> [options]"
    echo -e ""
    echo -e "${BOLD}CORE COMMANDS:${RESET}"
    echo -e "    ${CYAN}start${RESET}         Start Agility Shell (uses systemd user unit if installed)"
    echo -e "    ${CYAN}stop${RESET}          Stop running Agility Shell instance"
    echo -e "    ${CYAN}restart${RESET}       Restart Agility Shell (-f/--foreground for console logs)"
    echo -e "    ${CYAN}status${RESET}        Check runtime status and active process information"
    echo -e "    ${CYAN}deps${RESET}          Test and install missing dependencies one-by-one"
    echo -e "    ${CYAN}install${RESET}       Install or reinstall Agility Shell system-wide"
    echo -e "    ${CYAN}update${RESET}        Update Agility Shell in-place (preserves configs)"
    echo -e "    ${CYAN}uninstall${RESET}     Uninstall Agility Shell (--purge to wipe user configs)"
    echo -e "    ${CYAN}suits${RESET}         Manage desktop suites (list, next, prev, toggle, switch <id>)"
    echo -e ""
    echo -e "${BOLD}OPTIONS:${RESET}"
    echo -e "    ${CYAN}-h, --help${RESET}    Show this help message"
    echo -e "    ${CYAN}-v, --version${RESET} Show Agility Shell version"
    echo -e ""
    echo -e "${BOLD}EXAMPLES:${RESET}"
    echo -e "    ${DIM}# Test and install dependencies:${RESET}"
    echo -e "    agl deps"
    echo -e ""
    echo -e "    ${DIM}# Start or restart shell gracefully:${RESET}"
    echo -e "    agl restart"
    echo -e ""
    echo -e "    ${DIM}# Inspect live status:${RESET}"
    echo -e "    agl status"
    echo -e ""
    echo -e "    ${DIM}# Update shell and rebuild:${RESET}"
    echo -e "    agl update"
    echo -e ""
    echo -e "    ${DIM}# Start in foreground for debugging:${RESET}"
    echo -e "    agl restart -f"
}

cmd_start() {
    if systemctl --user list-unit-files agility-shell.service &>/dev/null; then
        info "Starting Agility Shell via systemd user service..."
        systemctl --user reset-failed agility-shell.service 2>/dev/null || true
        systemctl --user start agility-shell.service
        success "Service started. Check status: agl status"
    elif command -v agility-shell &>/dev/null; then
        info "Starting Agility Shell binary..."
        if [[ -f "$REPO_DIR/scripts/start.sh" ]]; then
            exec "$REPO_DIR/scripts/start.sh" "$@"
        else
            exec agility-shell "$@"
        fi
    elif [[ -n "$REPO_DIR" && -f "$REPO_DIR/scripts/start.sh" ]]; then
        exec "$REPO_DIR/scripts/start.sh" "$@"
    else
        die "Agility Shell installation not found. Run 'agl install' first."
    fi
}

cmd_stop() {
    info "Stopping Agility Shell..."
    if systemctl --user is-active --quiet agility-shell.service 2>/dev/null; then
        systemctl --user stop agility-shell.service
        success "Agility Shell systemd service stopped."
        return 0
    fi

    local pids
    pids=$(pgrep -x "agility-shell" 2>/dev/null || true)
    pids+=" $(pgrep -f "python.*agility-shell/main\.py" 2>/dev/null || true)"
    pids+=" $(pgrep -f "python.*[m]ain\.py" 2>/dev/null || true)"

    if [[ -n "${pids// /}" ]]; then
        kill -15 $pids 2>/dev/null || true
        sleep 0.5
        kill -9 $pids 2>/dev/null || true
        success "Agility Shell stopped."
    else
        info "Agility Shell is not currently running."
    fi
}

cmd_restart() {
    if [[ -n "$REPO_DIR" && -f "$REPO_DIR/scripts/restart.sh" ]]; then
        exec "$REPO_DIR/scripts/restart.sh" "$@"
    elif [[ -f "/usr/share/agility-shell/scripts/restart.sh" ]]; then
        exec "/usr/share/agility-shell/scripts/restart.sh" "$@"
    elif command -v agility-shell &>/dev/null; then
        cmd_stop
        cmd_start "$@"
    else
        die "restart script not found. Run 'agl install' first."
    fi
}

cmd_status() {
    echo -e "${BOLD}Agility Shell Runtime Status:${RESET}"
    echo -e "  Version:    ${CYAN}v$VERSION${RESET}"
    echo -e "  System Dir: ${CYAN}$SYSTEM_DATA${RESET} $([[ -d "$SYSTEM_DATA" ]] && echo -e "${GREEN}(installed)${RESET}" || echo -e "${YELLOW}(absent)${RESET}")"
    echo -e "  Config Dir: ${CYAN}$CONFIG_DIR${RESET} $([[ -d "$CONFIG_DIR" ]] && echo -e "${GREEN}(present)${RESET}" || echo -e "${DIM}(default)${RESET}")"
    echo

    if systemctl --user list-unit-files agility-shell.service &>/dev/null; then
        echo -e "${BOLD}Systemd User Unit:${RESET}"
        systemctl --user status agility-shell.service --no-pager || true
        echo
    fi

    local pids
    pids=$(pgrep -x "agility-shell" 2>/dev/null || true)
    pids+=" $(pgrep -f "python.*[m]ain\.py" 2>/dev/null || true)"
    
    if [[ -n "${pids// /}" ]]; then
        success "Agility Shell is running (PIDs: ${pids//  / })"
    else
        warn "Agility Shell is not currently active."
    fi
}

cmd_deps() {
    info "Launching Agility Shell dependency checker..."
    if [[ -n "$REPO_DIR" && -f "$REPO_DIR/scripts/install.sh" ]]; then
        exec "$REPO_DIR/scripts/install.sh" --deps "$@"
    elif [[ -n "$REPO_DIR" && -f "$REPO_DIR/install.sh" ]]; then
        exec "$REPO_DIR/install.sh" --deps "$@"
    elif [[ -f "/usr/share/agility-shell/scripts/install.sh" ]]; then
        exec "/usr/share/agility-shell/scripts/install.sh" --deps "$@"
    else
        local tmp_dir
        tmp_dir="$(mktemp -d)"
        trap 'rm -rf "$tmp_dir"' EXIT
        curl -fsSL https://raw.githubusercontent.com/TattvaOrg/agility-shell/main/scripts/install.sh -o "$tmp_dir/install.sh"
        chmod +x "$tmp_dir/install.sh"
        exec "$tmp_dir/install.sh" --deps "$@"
    fi
}

cmd_install() {
    info "Launching Agility Shell installer..."
    if [[ -n "$REPO_DIR" && -f "$REPO_DIR/scripts/install.sh" ]]; then
        exec "$REPO_DIR/scripts/install.sh" "$@"
    elif [[ -n "$REPO_DIR" && -f "$REPO_DIR/install.sh" ]]; then
        exec "$REPO_DIR/install.sh" "$@"
    else
        local tmp_dir
        tmp_dir="$(mktemp -d)"
        trap 'rm -rf "$tmp_dir"' EXIT
        curl -fsSL https://raw.githubusercontent.com/TattvaOrg/agility-shell/main/scripts/install.sh -o "$tmp_dir/install.sh"
        chmod +x "$tmp_dir/install.sh"
        exec "$tmp_dir/install.sh" "$@"
    fi
}

cmd_update() {
    info "Launching Agility Shell updater..."
    if [[ -n "$REPO_DIR" && -f "$REPO_DIR/scripts/update.sh" ]]; then
        exec "$REPO_DIR/scripts/update.sh" "$@"
    elif [[ -n "$REPO_DIR" && -f "$REPO_DIR/update.sh" ]]; then
        exec "$REPO_DIR/update.sh" "$@"
    elif [[ -f "/usr/share/agility-shell/scripts/update.sh" ]]; then
        exec "/usr/share/agility-shell/scripts/update.sh" "$@"
    else
        local tmp_dir
        tmp_dir="$(mktemp -d)"
        trap 'rm -rf "$tmp_dir"' EXIT
        curl -fsSL https://raw.githubusercontent.com/TattvaOrg/agility-shell/main/scripts/update.sh -o "$tmp_dir/update.sh"
        chmod +x "$tmp_dir/update.sh"
        exec "$tmp_dir/update.sh" "$@"
    fi
}

cmd_uninstall() {
    if [[ -n "$REPO_DIR" && -f "$REPO_DIR/scripts/uninstall.sh" ]]; then
        exec "$REPO_DIR/scripts/uninstall.sh" "$@"
    elif [[ -f "/usr/share/agility-shell/scripts/uninstall.sh" ]]; then
        exec "/usr/share/agility-shell/scripts/uninstall.sh" "$@"
    else
        local tmp_dir
        tmp_dir="$(mktemp -d)"
        trap 'rm -rf "$tmp_dir"' EXIT
        curl -fsSL https://raw.githubusercontent.com/TattvaOrg/agility-shell/main/scripts/uninstall.sh -o "$tmp_dir/uninstall.sh"
        chmod +x "$tmp_dir/uninstall.sh"
        exec "$tmp_dir/uninstall.sh" "$@"
    fi
}

cmd_suits() {
    local action="${1:-list}"
    shift || true
    case "$action" in
        next)
            fabric-cli exec agility-shell "suits_service.cycle_next_suite()" 2>/dev/null || info "Shell not currently running or fabric-cli unavailable."
            ;;
        prev)
            fabric-cli exec agility-shell "suits_service.cycle_prev_suite()" 2>/dev/null || info "Shell not currently running or fabric-cli unavailable."
            ;;
        toggle)
            fabric-cli exec agility-shell "bar_manager.toggle('Suits')" 2>/dev/null || info "Shell not currently running or fabric-cli unavailable."
            ;;
        switch)
            local target="${1:-}"
            if [[ -n "$target" ]]; then
                fabric-cli exec agility-shell "suits_service.switch_suite('$target')" 2>/dev/null || info "Shell not currently running or fabric-cli unavailable."
            else
                die "Usage: agl suits switch <desktop_id>"
            fi
            ;;
        export)
            local target="${1:-}"
            local dest="${2:-}"
            if [[ -n "$target" && -n "$dest" ]]; then
                fabric-cli exec agility-shell "suits_service.export_suite('$target', '$dest')" 2>/dev/null || info "Shell not currently running or fabric-cli unavailable."
            else
                die "Usage: agl suits export <desktop_id> <dest_file.json>"
            fi
            ;;
        import)
            local src="${1:-}"
            if [[ -n "$src" ]]; then
                fabric-cli exec agility-shell "suits_service.import_suite('$src')" 2>/dev/null || info "Shell not currently running or fabric-cli unavailable."
            else
                die "Usage: agl suits import <preset_file.json>"
            fi
            ;;
        list|*)
            python3 -c "
import json, os
p = os.path.expanduser('~/.config/agility-shell/config/suits.json')
if os.path.exists(p):
    with open(p) as f:
        d = json.load(f)
    active = d.get('active_id', '')
    for s in d.get('suites', []):
        prefix = '* ' if s.get('id') == active else '  '
        print(f\"{prefix}{s.get('name', 'Desktop')} (id: {s.get('id')})\")
else:
    print('No desktop suites configured yet.')
"
            ;;
    esac
}

# Subcommand routing
COMMAND="${1:-}"
if [[ -n "$COMMAND" ]]; then
    shift || true
fi

case "$COMMAND" in
    start)
        cmd_start "$@"
        ;;
    stop)
        cmd_stop "$@"
        ;;
    restart)
        cmd_restart "$@"
        ;;
    status)
        cmd_status "$@"
        ;;
    deps|check-deps)
        cmd_deps "$@"
        ;;
    install)
        cmd_install "$@"
        ;;
    update)
        cmd_update "$@"
        ;;
    uninstall)
        cmd_uninstall "$@"
        ;;
    suits)
        cmd_suits "$@"
        ;;
    -v|--version|version)
        echo -e "Agility Shell CLI (agl) v$VERSION"
        ;;
    -h|--help|help|"")
        show_help
        ;;
    *)
        error "Unknown command: '$COMMAND'"
        echo ""
        show_help
        exit 1
        ;;
esac
